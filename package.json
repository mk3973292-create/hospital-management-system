{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "dashboard"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND,DASHBOARD\" -c \"cyan,green,magenta\" \"node --watch backend/server.js\" \"npm -w frontend run dev\" \"npm -w dashboard run dev\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm -w frontend run dev",
    "dev:dashboard": "npm -w dashboard run dev",
    "build": "node scripts/build.js",
    "start": "node backend/server.js",
    "install:all": "npm install"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.8.0",
    "mongoose": "^9.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "react-toastify": "^11.0.5",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "nodemon": "^3.1.14",
    "vite": "^8.0.4"
  }
}
